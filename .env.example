# Ghostea deployment profile (Phase 16)
GHOSTEA_DEPLOYMENT_MODE=managed
GHOSTEA_DATABASE_PROVIDER=supabase_rest
GHOSTEA_STORAGE_PROVIDER=supabase
GHOSTEA_DASHBOARD_HOST=vercel

# Render
BOT_TOKEN=
SUPABASE_URL=
SUPABASE_KEY=
DASHBOARD_API_KEY=
DASHBOARD_ORIGIN=https://your-dashboard.vercel.app
GHOSTEA_PROXY_SIGNING_SECRET=long-random-proxy-signing-secret
PORT=10000

# Vercel dashboard (set in Vercel, not Render)
# GHOSTEA_API_URL=https://your-render-service.onrender.com
# GHOSTEA_API_KEY=same-as-Render-DASHBOARD_API_KEY
# GHOSTEA_SUPERADMIN_USERNAME=superadmin
# GHOSTEA_ADMIN_PASSWORD=your-initial-superadmin-password
# GHOSTEA_SESSION_SECRET=long-random-session-secret
# GHOSTEA_PROXY_SIGNING_SECRET=same-random-secret-as-Render

# Self-hosted backend + dashboard (Phase 21)
# GHOSTEA_DEPLOYMENT_MODE=self_hosted
# GHOSTEA_DATABASE_PROVIDER=postgresql
# GHOSTEA_STORAGE_PROVIDER=local
# GHOSTEA_DASHBOARD_HOST=vps
# DASHBOARD_ORIGIN=https://ghostea.example.com
# GHOSTEA_SESSION_SECRET=long-random-dashboard-session-secret-at-least-32-chars
# PORT=10000


# Phase 17 — self-hosted PostgreSQL
# Use with GHOSTEA_DEPLOYMENT_MODE=self_hosted
# DATABASE_URL=postgresql://ghostea:CHANGE_ME@postgres:5432/ghostea

# Phase 18 — self-hosted local storage
# Files are stored on the VPS in this directory (Docker uses /app/data/storage).
# GHOSTEA_LOCAL_STORAGE_ROOT=/app/data/storage
# GHOSTEA_LOCAL_STORAGE_MAX_BYTES=20971520

# Phase 22 — managed deployment baseline
# Render: Bot/API | Supabase: DB + Storage | Vercel: Dashboard
# Keep these three profile values together in managed deployments.

# Phase 19 — storage providers
# Managed Supabase Storage (recommended managed storage)
# GHOSTEA_SUPABASE_STORAGE_BUCKET=ghostea
# GHOSTEA_REMOTE_STORAGE_MAX_BYTES=20971520

# S3-compatible storage (advanced/custom profile)
# GHOSTEA_S3_BUCKET=
# GHOSTEA_S3_ACCESS_KEY=
# GHOSTEA_S3_SECRET_KEY=
# GHOSTEA_S3_REGION=us-east-1
# GHOSTEA_S3_ENDPOINT_URL=

# Telegram update delivery (polling is the default for Render testing).
GHOSTEA_UPDATE_MODE=polling
# Only required when GHOSTEA_UPDATE_MODE=webhook:
# GHOSTEA_WEBHOOK_URL=https://your-public-host.example/telegram/webhook
# GHOSTEA_WEBHOOK_SECRET_TOKEN=replace-with-random-secret
# GHOSTEA_WEBHOOK_PATH=/telegram/webhook

# Phase 29 — durable background worker
GHOSTEA_JOB_WORKER_ENABLED=true
GHOSTEA_JOB_WORKER_POLL_SECONDS=2
GHOSTEA_JOB_LEASE_SECONDS=120
GHOSTEA_JOB_MAX_ATTEMPTS=5
GHOSTEA_JOB_BATCH_SIZE=1
GHOSTEA_JOB_PAYLOAD_MAX_BYTES=65536

# Phase 30 — bounded TTL/LRU caches
GHOSTEA_CACHE_TTL_SECONDS=10
GHOSTEA_CACHE_MAX_ENTRIES=5000
GHOSTEA_DASHBOARD_CACHE_TTL_SECONDS=5
GHOSTEA_DASHBOARD_CACHE_MAX_ENTRIES=1000
